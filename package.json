{
  "name": "armaturina-bot",
  "version": "2.0.0",
  "description": "Admin-only Telegram group bot for random sticker/GIF replies.",
  "type": "module",
  "module": "src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "typecheck": "tsgo --noEmit",
    "build": "tsgo -p tsconfig.build.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:bun": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@grammyjs/runner": "^2.0.3",
    "dotenv": "^16.6.1",
    "grammy": "^1.44.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260702.3"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  }
}
